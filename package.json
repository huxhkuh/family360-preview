{
  "name": "family360-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:demo": "node scripts/check-demo.mjs",
    "test:professional-admin": "node scripts/check-pro-admin.mjs",
    "test:ux": "node scripts/check-mint.mjs && node scripts/check-mint-workflow.mjs",
    "test:client-intake": "node scripts/check-client-intake.mjs",
    "test:client-copy": "node scripts/check-client-copy.mjs",
    "test:client-focus": "node scripts/check-client-focus.mjs",
    "test:chapter-process": "node scripts/check-chapter-process.mjs",
    "test:client-workspace": "node scripts/check-client-workspace.mjs && node scripts/check-client-document-request.mjs",
    "test:client-folio": "node scripts/check-client-folio.mjs",
    "test:branding": "node scripts/check-branding.mjs",
    "test:companion": "node scripts/check-companion.mjs",
    "test:date-picker": "node scripts/check-date-picker.mjs",
    "test:client-decisions": "node scripts/check-client-decisions.mjs",
    "test:new-client-optional": "node scripts/check-new-client-optional.mjs",
    "test:guided-call": "node scripts/check-guided-call.mjs",
    "test:yitzchak-feedback": "node scripts/check-yitzchak-feedback.mjs",
    "test:growth": "node scripts/check-growth.mjs",
    "test:final-report": "node scripts/check-final-report.mjs",
    "test:representative": "node scripts/check-representative.mjs",
    "test:homepage": "node scripts/check-homepage.mjs",
    "test:completed-example": "node scripts/check-completed-example.mjs",
    "test:customer-journey": "node scripts/check-customer-journey.mjs",
    "test:workspace-brand": "node scripts/check-workspace-brand.mjs",
    "test:hero-gaze": "node scripts/check-hero-gaze.mjs",
    "dev:live": "vite --config vite.live.config.ts",
    "build:live": "tsc --noEmit && vite build --config vite.live.config.ts",
    "test:server": "vitest run server/tests",
    "check:server": "tsc --project server/tsconfig.json",
    "dev:api": "wrangler dev --config server/wrangler.jsonc",
    "deploy:api:staging": "wrangler deploy --config server/wrangler.jsonc",
    "test:runtime": "wrangler deploy --config server/wrangler.jsonc --dry-run --minify --outdir artifacts/runtime && node scripts/check-worker-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/assistant": "5.3.0",
    "@supabase/supabase-js": "2.115.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "miniflare": "5.20261023.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
