{
  "name": "family360-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:demo": "node scripts/check-demo.mjs",
    "test:professional-admin": "node scripts/check-pro-admin.mjs",
    "test:ux": "node scripts/check-mint.mjs && node scripts/check-mint-workflow.mjs",
    "test:client-intake": "node scripts/check-client-intake.mjs",
    "test:chapter-process": "node scripts/check-chapter-process.mjs",
    "test:client-workspace": "node scripts/check-client-workspace.mjs && node scripts/check-client-document-request.mjs",
    "test:client-folio": "node scripts/check-client-folio.mjs",
    "test:branding": "node scripts/check-branding.mjs"
  },
  "dependencies": {
    "@fontsource-variable/assistant": "5.3.0",
    "@supabase/supabase-js": "2.115.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
